# Flan Media Server Configuration

# Network Port and Host
PORT=4907
HOST=0.0.0.0

# Storage Paths
MEDIA_DIR=./media
DB_PATH=./data/flan.db

# Resource & Stream Limits
MAX_CONCURRENT_STREAMS=3

# Security & Session Authentication
# 32-byte hex key for HMAC session signing. If omitted, Flan auto-generates
# and persists a 32-byte random key to data/.session_secret with 0600 permissions.
# SESSION_SECRET=

# Memory & Performance Tuning (Optional)
# GOMEMLIMIT=16MiB
# GOGC=30
