# Flan Media Server Configuration

# Network Port and Host
PORT=4907
HOST=0.0.0.0

# Storage Paths
# MEDIA_DIR holds fixed subdirectories: ./media/video and ./media/books.
# If MEDIA_DIR is left blank or omitted, Flan defaults to ./media
MEDIA_DIR=./media
DB_PATH=./data/flan.db

# Security & Session Authentication
# 32-byte hex key for HMAC session signing and signed download URLs. If omitted,
# Flan auto-generates and persists a 32-byte random key to data/.session_secret with 0600 permissions.
# SESSION_SECRET=

# Comma-separated list of trusted reverse proxy IP addresses or CIDRs (e.g. 127.0.0.1, 10.0.0.0/8)
# Used to safely parse X-Forwarded-For for PIN lockout protection. Leave empty for direct LAN access.
# TRUSTED_PROXIES=

# Go Runtime Tuning (Optional for resource-constrained systems)
# GOMEMLIMIT=32MiB
# GOGC=50
