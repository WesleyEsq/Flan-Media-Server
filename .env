# Flan Media Server Configuration

# Network Port and Host
PORT=4907
HOST=0.0.0.0

# Storage Paths
# Default directory used during first-time setup if no external drives are specified.
# Flan manages multiple libraries (movies, tv, books) dynamically in SQLite.
# If MEDIA_DIR is left blank or omitted, Flan defaults to ./media
MEDIA_DIR=./media
DB_PATH=./data/flan.db

# Resource & Stream Limits
MAX_CONCURRENT_STREAMS=3

# Security & Session Authentication
# 32-byte hex key for HMAC session signing. If omitted, Flan auto-generates
# and persists a 32-byte random key to data/.session_secret with 0600 permissions.
# SESSION_SECRET=

# External Metadata Scraping (Optional)
# The Movie Database (TMDB) API Key or Read Access Token.
# If omitted or blank, Flan operates offline, falling back to local folder art
# (poster.jpg) or embedded SVG placeholders with zero network requests.
# TMDB_API_KEY=

# Memory & Performance Tuning (Optional)
# GOMEMLIMIT=16MiB
# GOGC=30
